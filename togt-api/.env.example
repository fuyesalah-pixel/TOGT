# TOGT API environment
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# PostgreSQL (docker-compose at repo root)
DATABASE_URL=postgresql://togt_admin:change_me_in_local_env@localhost:5432/togt_db

# Valkey (Redis-compatible)
VALKEY_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Comma-separated emails that become ADMIN on first Google login
ADMIN_EMAILS=admin@togt.com

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=togt-uploads
R2_BUCKET_NAME=togt-uploads
R2_PUBLIC_URL=

# Resend (email) - optional; emails are logged when not set
RESEND_API_KEY=
EMAIL_FROM=TOGT <noreply@togt.com>

# SMSEthiopia - optional; SMS are logged when not set
SMS_ETHIOPIA_TOKEN=

# Cookies: set true in production (HTTPS, SameSite=None)
COOKIE_SECURE=false
MAPBOX_ACCESS_TOKEN=

# Chapa payment integration (never commit real keys)
CHAPA_SECRET_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_API_URL=https://api.chapa.co/v1
