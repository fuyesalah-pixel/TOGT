# =========================================
# TOGT Tour & Travel Management System
# Root environment variables (used by docker-compose.yml)
# Copy this file to ".env" and fill in real values.
# =========================================

# --- PostgreSQL ---
POSTGRES_USER=togt_admin
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=togt_db
POSTGRES_PORT=5432

# --- Valkey (Redis-compatible) ---
VALKEY_PORT=6379

# --- GlitchTip (added in a later phase) ---
# GLITCHTIP_PORT=8080
