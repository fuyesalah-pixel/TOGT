# TOGT API environment
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# PostgreSQL (docker-compose at repo root)
DATABASE_URL=postgresql://togt_admin:change_me_in_local_env@localhost:5432/togt_db

# Valkey (Redis-compatible)
VALKEY_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Comma-separated emails that become ADMIN on first Google login
ADMIN_EMAILS=admin@togt.com

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=togt-uploads
R2_BUCKET_NAME=togt-uploads
R2_PUBLIC_URL=

# Resend (email) - optional; emails are logged when not set
RESEND_API_KEY=
EMAIL_FROM=TOGT <noreply@togt.com>

# SMSEthiopia - optional; SMS are logged when not set
SMS_ETHIOPIA_TOKEN=
SMS_ETHIOPIA_API_KEY=
SMS_ETHIOPIA_SENDER_ID=TOGT

# Hostinger SMTP for admin/manual email delivery
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=info@togttrading.com
HOSTINGER_SMTP_PASSWORD=
HOSTINGER_SMTP_FROM=TOGT <info@togttrading.com>

# Cookies: set true in production (HTTPS, SameSite=None)
COOKIE_SECURE=false
MAPBOX_ACCESS_TOKEN=

# Chapa payment integration (never commit real keys)
CHAPA_SECRET_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_API_URL=https://api.chapa.co/v1

# Duffel flight search + booking (server-side only). Start with TEST mode token.
# Test tokens begin with `duffel_test_`. Obtain from Duffel Dashboard > Developers > Access Tokens.
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
# Markup added on top of Duffel's priced total (%), converted to ETB for customer payment in Chapa.
DUFFEL_MARKUP_PERCENT=8
# Duffel prices fares in the account's configured currency. Map each possible currency code
# to its ETB sell-rate (comma-separated CODE=rate). DUFFEL_BASE_CURRENCY is the fallback used
# if Duffel returns an unmapped currency. In test mode this varies (e.g. first run returned AUD).
DUFFEL_BASE_CURRENCY=USD
DUFFEL_CURRENCY_RATES=USD=125,AUD=86,EUR=142,GBP=168,ETB=1,INR=1.5,SAR=33,AED=34
DUFFEL_FALLBACK_ETB_RATE=55.5
CHAPA_ENCRYPTION_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_API_URL=https://api.chapa.co/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://travel.togttrading.com/api/telegram/webhook
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
