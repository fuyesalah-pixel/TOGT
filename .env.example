[TEMPLATE]
# =========================================
# TOGT Tour & Travel Management System
# Root environment variables for docker-compose.yaml (production stack)
# Copy this file to ".env" (repo root, next to docker-compose.yaml)
# and fill in real values. Never commit the real .env.
# =========================================

# --- PostgreSQL (persisted in the togt_postgres_data volume) ---
POSTGRES_USER=togt
POSTGRES_PASSWORD=change_me
POSTGRES_DB=togt_db

# --- JWT secrets (openssl rand -hex 32 for each) ---
# TTLs are in seconds; defaults in docker-compose.yaml are 2592000 = 30 days.
JWT_ACCESS_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=2592000
# JWT_REFRESH_TTL=2592000

# --- Google OAuth (callback is fixed to https://travel.togttrading.com/api/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin bootstrap (comma-separated emails auto-promoted to ADMIN) ---
ADMIN_EMAILS=

# --- Chapa payments ---
CHAPA_SECRET_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_WEBHOOK_SECRET=
NEXT_PUBLIC_CHAPA_PUBLIC_KEY=

# --- Cloudflare R2 storage ---
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET=togt-storage
R2_PUBLIC_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
# EMAIL_FROM=TOGT <noreply@togttrading.com>

# --- SMS ---
SMS_ETHIOPIA_TOKEN=

# --- Maps (baked into the togt-web image at build time) ---
MAPBOX_ACCESS_TOKEN=
